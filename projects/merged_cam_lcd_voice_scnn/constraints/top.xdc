set_property -dict {PACKAGE_PIN D20 IOSTANDARD LVCMOS33} [get_ports track_r2]
#==============================================================
#  top.xdc  --   robei7020 八角板 ZYNQ-7020（摄像头 + LCD + 语音）
#  OV5640 接口=42_ov5640_udp_pc，RGB LCD=21_lcd_rgb_colorbar（ATK-4384 4.3寸 800x480）
#  系统时钟 33.333MHz（N18），LCD 像素钟直接同源 33.333MHz（top.v 已去掉二分频）。
#  注意：OV5640 模块自带 24MHz 晶振，FPGA 不输出 cam_xclk，
#        故本约束与 top.v 均无 cam_xclk。
#  最下面一段是 LU-ASR02 语音模块的 5 个脚（摄像头/LCD 那两段是从底座工程原样搬来的）。
#==============================================================

# ---------- 系统 ----------
create_clock -period 30.000 -name sys_clk [get_ports sys_clk]

# ---------- OV5640 摄像头接口（42_ov5640_udp_pc）----------
create_clock -period 40.000 -name cam_pclk [get_ports cam_pclk]
# PCLK regular-IO routing is applied by implementation-only impl_route.xdc.

# ---------- ATK-4384 RGB888 800x480（21_lcd_rgb_colorbar 引脚）----------
# lcd_rgb[23:16]=R, [15:8]=G, [7:0]=B，直插板载 RGB LCD 座

# ---------- LU-ASR02 语音模块（UART 115200 8N1）----------
# 本板实测接线，与下面两行 PACKAGE_PIN 一致（已上板验证通信正常）：
#   asr_rxd (P18) <- 模块 TXD
#   asr_txd (T20) -> 模块 RXD
# 上拉不能省：模块没上电时这根线悬空，没上拉会把空间噪声当成串口数据，凭空收进乱码帧。
set_property PULLTYPE PULLUP [get_ports asr_rxd]

set_property DRIVE 8 [get_ports asr_txd]


# ---------- 板间串口链路：接下层板 realfinal_min_102404（2 个脚）----------
# 两块板都是 33.333MHz，115200 8N1，交叉接、必须共地，已上板验证能通：
#   本板 link_tx (Y17) --> 下层板 link_rx (D20)
#   本板 link_rx (V16) <-- 下层板 link_tx (F20)
# 上拉不能省：下层板没上电时这根线悬空，没上拉会把空间噪声当成串口数据收进来。
set_property DRIVE 8 [get_ports link_tx]

set_property PULLTYPE PULLUP [get_ports link_rx]

# ---------- 五路循迹传感器（接在本板，状态经链路转发给下层板）----------
# 实际引脚见上方 PACKAGE_PIN：track_l2=C20、track_l1=D19、track_m=B19、
# track_r1=B20、track_r2=D20（顺序：传感器从左到右）。
# 换线时只改上面 5 行 PACKAGE_PIN，RTL 不用动。
# 上拉：多数循迹模块是集电极开路输出，不加上拉读不出高电平；不加也不影响用推挽输出的模块。
set_property PULLTYPE PULLUP [get_ports track_l2]
set_property PULLTYPE PULLUP [get_ports track_l1]
set_property PULLTYPE PULLUP [get_ports track_m]
set_property PULLTYPE PULLUP [get_ports track_r1]
set_property PULLTYPE PULLUP [get_ports track_r2]

# ---------- 异步输入时序例外 ----------
# asr_rxd 是异步输入（模块什么时候说话不确定），RTL 里已做两级同步采样，
# 不需要工具再分析它的建立/保持时间。
set _xlnx_shared_i0 [all_registers]
set_false_path -from [get_ports asr_rxd] -to $_xlnx_shared_i0

# link_rx 同理：它接的是另一块板，什么时候来数据由对方决定，本板不跟它做时序收敛。
set_false_path -from [get_ports link_rx] -to $_xlnx_shared_i0

# 5 路循迹也是异步输入（传感器什么时候跳变不确定），RTL 里已做两级同步。
set_false_path -from [get_ports {track_l2 track_l1 track_m track_r1 track_r2}] -to $_xlnx_shared_i0









# Independent sensor PCLK and system oscillator; all crossings use CDC logic.
set_clock_groups -asynchronous -group [get_clocks sys_clk] -group [get_clocks cam_pclk]
